# Kessick AUTHENTICATED FRONTEND NODE SERVICE ONLY.
# Requires PR #2 production build/proxy changes or reviewed equivalent.
# Replace every REPLACE_ value before import. Read RENDER_ENV_SETUP.md.
NODE_ENV=production
BASE_PATH=/
API_ORIGIN=REPLACE_WITH_ACTUAL_API_HTTPS_ORIGIN
VITE_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PROXY_URL=/api/__clerk

# VITE_ values are public browser build inputs. Never put server secrets here.
# Rebuild the frontend after changing VITE_ values.
# PORT is supplied by Render; intentionally not set here.
