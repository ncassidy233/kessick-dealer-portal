# Kessick API NODE SERVICE ONLY. Not the frontend or static preview.
# Replace every REPLACE_ value before import. Read RENDER_ENV_SETUP.md.
NODE_ENV=production
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SECRET_KEY
DATABASE_URL=REPLACE_WITH_ACTUAL_POSTGRES_CONNECTION_STRING
KESSICK_ALLOWED_ORIGINS=https://kessick-dealer-black.onrender.com
# Set SESSION_SECRET directly in Render; do not share its value with Claude.
SESSION_SECRET=REPLACE_DIRECTLY_IN_RENDER_WITH_EXISTING_OR_GENERATED_SECRET
PRIVATE_OBJECT_DIR=REPLACE_WITH_SLASH_PREFIXED_PRIVATE_GCS_PATH
PUBLIC_OBJECT_SEARCH_PATHS=REPLACE_WITH_EXISTING_SLASH_PREFIXED_PUBLIC_GCS_PATHS
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_GCP_PROJECT_ID
# Add Render Secret File kessick-gcp.json with the authorized service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/kessick-gcp.json

# OPTIONAL WEB PUSH: uncomment only after real configuration.
# VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
# VAPID_SUBJECT=REPLACE_WITH_VALID_MAILTO_OR_HTTPS_CONTACT

# OPTIONAL AI: uncomment only after real provider configuration.
# AI_INTEGRATIONS_OPENAI_BASE_URL=REPLACE_WITH_ACTUAL_PROVIDER_BASE_URL
# AI_INTEGRATIONS_OPENAI_API_KEY=REPLACE_WITH_ACTUAL_PROVIDER_API_KEY

# PORT is supplied by Render; intentionally not set here.
